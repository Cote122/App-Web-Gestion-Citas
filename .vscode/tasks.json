{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: dotnet run",
      "type": "process",
      "command": "dotnet",
      "args": ["run"],
      "options": { "cwd": "${workspaceFolder}/backend/GestionCitas.Api" },
